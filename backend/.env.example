# Optional backend-local configuration. The project-root .env is also loaded.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=vedaverse
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Replace with a unique secret of at least 32 characters before running.
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
