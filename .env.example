# Copy to .env and replace the secret placeholders before running.
GROQ_API_KEY=your_groq_api_key_here

# Local MongoDB example. Use your own URI for a hosted MongoDB deployment.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=vedaverse
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# The backend requires a JWT secret of at least 32 characters.
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed browser origins and the frontend's FastAPI base URL.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
VEDAVERSE_API_URL=http://127.0.0.1:8000

# Frequently-asked-question answer cache (stored in MongoDB).
# A new question reuses a cached answer when its embedding similarity to a
# cached question is at least ANSWER_CACHE_SIMILARITY (0-1; higher is stricter).
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_SIMILARITY=0.92
ANSWER_CACHE_TTL_DAYS=30
